<Window x:Class="TestRefleksu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Legends"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#171923">

    <StackPanel Margin="25" VerticalAlignment="Center">

        <TextBlock Text="TEST REFLEKSU"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="pink"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock x:Name="Instrukcja"
                   Text="Kliknij Ciastek i czekaj na zielony kolor"
                   Foreground="White"
                   FontSize="15"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,15"/>

        <Button x:Name="Pole"
                Content="Ciastek"
                Height="100"
                FontSize="25"
                FontWeight="Bold"
                Background="#E34D58"
                Foreground="White"
                BorderThickness="0"
                Click="Pole_Click"/>

        <TextBlock x:Name="Wynik"
                   Text="Twój czas: --- ms"
                   Foreground="White"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,15"/>

        <Button x:Name="StartButton"
                Content="START"
                Height="45"
                FontSize="18"
                Background="#7457E8"
                Foreground="White"
                BorderThickness="0"
                Click="StartButton_Click"/>

    </StackPanel>
</Window>